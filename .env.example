# Garfo AI — variáveis de ambiente (SPEC seção 9).
# Copie para .env na raiz: `cp .env.example .env`. Nunca commite o .env.
# Os valores abaixo são fictícios ou de desenvolvimento local.

# ---------- API (apps/api) ----------
# Banco local do docker compose. Dentro do compose, a API usa o host "db" automaticamente.
DATABASE_URL=postgresql://garfo:garfo@localhost:5432/garfo

# "openai" ou "fake". Opcional: sem ele, a API usa "openai" se houver OPENAI_API_KEY e "fake" caso contrário.
# Com "fake", nada é enviado a provedores externos.
LLM_PROVIDER=fake

# Obrigatórias apenas quando LLM_PROVIDER=openai (o nome vale também para provedores compatíveis).
# Opção A, OpenAI: deixe OPENAI_BASE_URL comentada e use sua chave da OpenAI.
# Opção B, Gemini gratuito pela camada compatível com OpenAI (chave em https://aistudio.google.com/apikey):
#   OPENAI_API_KEY=<chave do Gemini>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_CHAT_MODEL=gemini-3.5-flash-lite   (alternativa: gemini-3.5-flash, mais lento)
#   LLM_EMBEDDING_MODEL=gemini-embedding-001
#   EMBEDDING_DIMENSIONS=1536
#   EVAL_PRICE_INPUT_USD_PER_MTOK=0 e EVAL_PRICE_OUTPUT_USD_PER_MTOK=0
# Com OPENAI_BASE_URL, o max_tokens sobe para 4096 (o thinking do Gemini conta nesse limite).
# Erros 429/503 do provedor são refeitos até 3 vezes (1 s, 2 s, 4 s); depois disso aparece "serviço sobrecarregado".
# Com OPENAI_BASE_URL, o chat também envia reasoning_effort (LLM_REASONING_EFFORT: none | minimal | low | medium | high;
# padrão minimal, menos thinking = respostas mais rápidas). Se o provedor recusar o valor, troque a variável;
# `pnpm llm:smoke` mostra o erro. Sem OPENAI_BASE_URL (OpenAI), ele nunca é enviado.
# LLM_REASONING_EFFORT=minimal
# Cada chamada de chat espera no máximo LLM_CALL_TIMEOUT_MS (padrão 15000) pelo PRIMEIRO trecho da resposta.
# Estourou: repete uma vez com LLM_FALLBACK_MODEL (opcional; sugestão: gemini-3.1-flash-lite). Sem ele, ou se o
# fallback também estourar, a interface mostra "O serviço de IA demorou demais para responder".
# LLM_CALL_TIMEOUT_MS=15000
# LLM_FALLBACK_MODEL=
# Trocou o modelo de embedding? Rode `pnpm db:embed` de novo.
OPENAI_API_KEY=
# OPENAI_BASE_URL=
LLM_CHAT_MODEL=
LLM_EMBEDDING_MODEL=text-embedding-3-small

EMBEDDING_DIMENSIONS=1536
CORS_ORIGIN=http://localhost:3000
MAX_DAILY_CHAT_REQUESTS=500
PORT=3001

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_GITHUB_URL=https://github.com/oriajsan/Garfo-AI

# ---------- Avaliação (pnpm eval, só com LLM_PROVIDER=openai) ----------
# Preço em US$ por milhão de tokens, usado só na estimativa de custo do relatório.
# Os padrões (0.15 e 0.60) valem para um modelo pequeno; ajuste ao modelo que você configurou.
# EVAL_PRICE_INPUT_USD_PER_MTOK=0.15
# EVAL_PRICE_OUTPUT_USD_PER_MTOK=0.60
# Pausa mínima, em milissegundos, entre o início de chamadas consecutivas ao provedor (chat e
# embeddings). Existe porque o plano gratuito do Gemini limita requisições por minuto.
# Padrão: 2000. Aumente (ex.: 5000) se aparecerem muitos 429. Vale só com LLM_PROVIDER=openai;
# com o provedor fake a pausa é sempre 0.
# EVAL_DELAY_MS=2000
# Roda só alguns casos: ids do evals/cases.json separados por vírgula. Id desconhecido dá erro
# antes de qualquer chamada. O relatório vai para evals/results/partial-latest.md (nunca latest.md).
# EVAL_ONLY=simple-spicy-40,conflict-burger-then-hummus
# Repete cada caso filtrado N vezes (padrão 1); só vale junto com EVAL_ONLY.
# EVAL_REPEAT=3

# ---------- Seed (pnpm db:seed) ----------
# Limites da transação interativa do seed (inteiros positivos, em milissegundos). Os padrões do
# Prisma (5 s e 2 s) estouram contra um banco remoto como o Neon ("Transaction not found").
# Padrões: 120000 (timeout) e 20000 (maxWait). Valor inválido dá erro antes de conectar.
# SEED_TX_TIMEOUT_MS=120000
# SEED_TX_MAX_WAIT_MS=20000
