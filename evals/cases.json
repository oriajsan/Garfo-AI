  {
    "id": "simple-vegetarian-40",
    "category": "simple_filters",
    "description": "Vegetariano até R$ 40: restrição e teto de preço viram filtros da busca.",
    "input": ["Quero algo vegetariano até R$ 40"],
    "expect": {
      "mustCallTools": ["search_dishes"],
      "mustNotCallTools": ["add_to_cart", "clear_cart"],
      "toolArgs": [
        {
          "tool": "search_dishes",
          "args": {
            "dietary_tags": {
              "includes": "vegetarian"
            },
            "max_price_reais": {
              "lte": 40
            }
          }
        }
      ],
      "recommendedDishesSatisfy": {
        "maxPriceReais": 40,
        "requiredTags": ["vegetarian"]
      },
      "minRecommendations": 1,
      "maxRecommendations": 3,
      "cartAfter": {
        "empty": true
      },
      "noHallucinatedDishes": true
    }
  },
