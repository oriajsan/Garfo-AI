{
  "name": "@garfo/evals",
  "version": "0.1.0",
  "private": true,
  "description": "Avaliação automatizada do agente do Garfo (20 casos, checagens por código)",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "eval": "ts-node --project tsconfig.json run-evals.ts",
