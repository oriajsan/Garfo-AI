{
  "name": "@garfo/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS do Garfo",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "build:bootstrap": "tsc -p tsconfig.bootstrap.json",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.ts --runInBand",
    "db:embed": "tsx scripts/embed-dishes.ts",
    "llm:smoke": "tsx scripts/llm-smoke.ts"
  },
  "dependencies": {
    "@garfo/shared": "workspace:^",
    "@nestjs/common": "^10",
    "@nestjs/core": "^10",
    "@nestjs/platform-express": "^10",
    "@nestjs/swagger": "^7",
    "@nestjs/throttler": "^6",
    "@prisma/client": "^5.22",
    "@scalar/nestjs-api-reference": "1.0.31",
    "helmet": "^8.3.0",
    "nestjs-zod": "^5.6.0",
    "openai": "^4",
    "prisma": "^5.22",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "zod": "^3.23",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10",
    "@nestjs/schematics": "^10",
    "@nestjs/testing": "^10",
    "@types/express": "^4",
    "@types/jest": "^29",
    "@types/supertest": "^7.2.1",
    "jest": "^29",
    "supertest": "^7.3.2",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "tsx": "^4"
  }
}
